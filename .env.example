SECRET_KEY=replace-with-a-random-secret-key
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8081,http://127.0.0.1:8081
DATABASE_URL=sqlite:///db.sqlite3
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7
# Hostinger Free Webmail SMTP
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.hostinger.com
EMAIL_PORT=465
EMAIL_USE_SSL=True
EMAIL_USE_TLS=False
EMAIL_HOST_USER=no-reply@scientice.health
EMAIL_HOST_PASSWORD=your_hostinger_email_password
DEFAULT_FROM_EMAIL=Scientice Medical Hub <no-reply@scientice.health>

CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/0
# Commands accept placeholders: {script_file}, {audio_file}, {avatar_file}, {output_dir}
VIDEO_TTS_COMMAND=
VIDEO_SADTALKER_COMMAND=
REPLICATE_API_TOKEN=your_replicate_api_token_here